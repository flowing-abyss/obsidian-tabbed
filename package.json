{
  "name": "tabbed",
  "version": "2.2.2",
  "private": true,
  "description": "Create lazy-loading tabs in your notes.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "pnpm typecheck && node esbuild.config.mjs production",
    "build:analyze": "pnpm typecheck && node esbuild.config.mjs production analyze",
    "preversion": "pnpm run verify && node release-check.mjs --release-ready && pnpm run test:e2e",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "postversion": "git push --follow-tags",
    "release": "pnpm version --tag-version-prefix ''",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "lint:css": "stylelint '**/*.css'",
    "typecheck": "tsc -noEmit -skipLibCheck",
    "typecheck:e2e": "tsc -p tests/e2e/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "wdio run tests/e2e/wdio.conf.mts",
    "test:e2e:android": "wdio run tests/e2e/wdio.mobile.conf.mts",
    "deadcode": "knip",
    "arch": "depcruise src --config dependency-cruiser.config.cjs --output-type err-long",
    "release:check": "node release-check.mjs",
    "verify:task": "pnpm lint && pnpm typecheck && pnpm test",
    "test:ai": "node --test \".ai/**/*.test.mjs\"",
    "verify": "pnpm format:check && pnpm lint && pnpm lint:css && pnpm typecheck && pnpm typecheck:e2e && pnpm arch && pnpm deadcode && pnpm test:ai && pnpm test:coverage && pnpm build && pnpm release:check",
    "ci": "pnpm verify",
    "prepare": "husky && node .ai/setup.mjs"
  },
  "lint-staged": {
    "*.{ts,mts,cts,js,mjs,cjs}": [
      "eslint --max-warnings 0 --no-warn-ignored --fix",
      "prettier --write"
    ],
    "*.css": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{json,jsonc,yml,yaml,md}": [
      "prettier --write"
    ]
  },
  "release": {
    "mainJsBudgetBytes": 524288
  },
  "keywords": [],
  "license": "MIT",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1",
    "pnpm": ">=11"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@types/mocha": "10.0.10",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "5.1.0",
    "@wdio/appium-service": "10.2.0",
    "@wdio/cli": "10.2.0",
    "@wdio/globals": "10.2.0",
    "@wdio/local-runner": "10.2.0",
    "@wdio/mocha-framework": "10.2.0",
    "appium": "3.9.0",
    "appium-uiautomator2-driver": "8.7.3",
    "dependency-cruiser": "^18.7.2",
    "esbuild": "0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-obsidianmd": "^0.5.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "expect-webdriverio": "8.1.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "jsdom": "^31.0.0",
    "knip": "^6.45.1",
    "lint-staged": "^17.6.0",
    "mocha": "12.0.3",
    "obsidian": "1.14.4",
    "obsidian-test-mocks": "^8.0.0",
    "prettier": "^3.10.0",
    "prettier-plugin-organize-imports": "^4.3.0",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "tsx": "4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "5.1.0",
    "wdio-obsidian-reporter": "3.5.0",
    "wdio-obsidian-service": "3.5.0",
    "webdriverio": "10.2.0"
  }
}
